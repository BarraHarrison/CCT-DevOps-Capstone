# Copy this file to .env for local development (never commit the real .env)

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=sqlite to skip Postgres for quick local commands.
DB_ENGINE=postgres
DB_NAME=bookcatalog
DB_USER=bookcatalog
DB_PASSWORD=bookcatalog
DB_HOST=localhost
DB_PORT=5432
